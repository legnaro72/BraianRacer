# Export this variable in your shell, or use .streamlit/secrets.toml.
# With no DATABASE_URL, Brain Racer uses local SQLite.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/brain_racer
# Only for compose.yaml: set a long random hexadecimal password.
# POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# MongoDB Atlas (preferred deployment): set MONGO_URI instead of DATABASE_URL.
# MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGO_DATABASE=brain_racer
